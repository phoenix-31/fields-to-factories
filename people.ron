// What people need and like. Each value is fixed, like 1.0, or a range, like (0.8, 1.2),
// that every person draws their own value from.
//
// needs         amounts of a characteristic needed per day, met before anything else
// preferences   how much people enjoy each characteristic beyond what they need:
//                 Log(weight)               always wanted, each extra unit worth a bit less
//                 Saturating(weight, scale) wanted until about `scale` extra, then barely
// leisure       weight on free time (Log)
// discount_rate how much less next year matters; with wear, sets how far ahead tools are valued

(
    land_quality: (0.8, 1.2),
    leisure: (0.8, 1.2),
    discount_rate: 0.05,
    needs: [
        (of: "nourishment", amount: (0.9, 1.1)),
    ],
    preferences: [
        (of: "nourishment", curve: Saturating(weight: 1.5, scale: 1.0)),
        (of: "comfort", curve: Log(weight: (0.8, 1.2))),
    ],
)
