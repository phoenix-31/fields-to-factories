// What people need and like. Each value is fixed, like 1.0, or a range, like (0.8, 1.2),
// that every person draws their own value from.
//
// needs         amounts of a characteristic needed per day, met before anything else, in order
// preferences   how much people enjoy each characteristic beyond what they need:
//                 Log(weight)               always wanted, each extra unit worth a bit less
//                 Saturating(weight, scale) wanted until about `scale` extra, then barely
// leisure       weight on free time (Log)
// count         how many people live on the map (a range is drawn once per Reset)
// migration     each year, `chance` of people look at `look_at` random places and move to the best
//               if it would cut the hours they need to meet their needs by at least `min_gain`
// endowments    range of quality for each resource; where a person falls in it depends on the terrain
//               where they live (see map.ron)
// discount_rate how much less next year matters; with wear, sets how far ahead tools are valued

(
    count: 1500,
    migration: (chance: 0.05, look_at: 6, min_gain: 0.1),
    endowments: [
        ("land", (0.3, 1.7)),
        ("pasture", (0.3, 1.7)),
        ("forest", (0.4, 1.6)),
        ("ore", (0.1, 1.6)),
    ],
    leisure: (0.8, 1.2),
    discount_rate: 0.05,
    needs: [
        (of: "nourishment", amount: (0.9, 1.1)),
        (of: "warmth", amount: (0.2, 0.3)),
    ],
    preferences: [
        (of: "nourishment", curve: Saturating(weight: 1.5, scale: 1.0)),
        (of: "warmth", curve: Saturating(weight: (0.4, 0.8), scale: 0.5)),
        (of: "comfort", curve: Log(weight: (0.8, 1.2))),
    ],
)
