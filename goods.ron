    (
        name: "iron plough",
        sector: "iron plough-making",
        color: (176, 112, 214),
        recipe: (rate: 0.1, inputs: [("iron", 2.0), ("wood", 2.0)]),
        lifetime: (15.0, 35.0),
    ),
]
