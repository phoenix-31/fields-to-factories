    ),
    (
        name: "furniture",
        sector: ["secondary", "carpentry"],
        bulk: 1.0,
        color: (230, 158, 52),
        provides: [("comfort", 1.0)],
        recipe: (rate: 1.0, inputs: [("wood", 0.5)]),
    ),
    (
        name: "wood",
        sector: ["primary", "forestry"],
        bulk: 1.5,
        color: (140, 98, 57),
        recipe: (rate: 2.0, uses: "forest"),
    ),
    (
        name: "charcoal",
        sector: ["secondary", "metals", "charcoal-burning"],
        bulk: 0.6,
        color: (96, 96, 104),
        recipe: (rate: 1.0, inputs: [("wood", 3.0)]),
    ),
    (
        name: "ore",
        sector: ["primary", "mining"],
        bulk: 2.0,
        color: (128, 146, 170),
        recipe: (rate: 0.5, uses: "ore"),
    ),
    (
        name: "iron",
        sector: ["secondary", "metals", "smelting"],
        bulk: 0.5,
        color: (200, 80, 120),
        recipe: (rate: 0.5, inputs: [("ore", 2.0), ("charcoal", 2.0)]),
    ),
    (
        name: "wooden plough",
        sector: ["secondary", "tools", "wooden plough-making"],
        bulk: 1.0,
        color: (214, 190, 140),
        recipe: (rate: 0.25, inputs: [("wood", 2.0)]),
