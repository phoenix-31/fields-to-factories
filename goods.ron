// Every good in the economy and how it is made. What people want is in people.ron.
//
// provides      what one unit gives a person, e.g. [("nourishment", 1.0)]; tools and inputs provide nothing
// recipe:
//   rate        units made per hour of work
//   uses        a resource whose quality (per person, see people.ron) scales the rate
//   improves    share the rate grows by each year, e.g. 0.015 for 1.5%
//   inputs      goods used up per unit made, e.g. [("wood", 2.0)]
//   tools       tools that multiply this recipe's rate; a person works with the best one they own
// lifetime      makes the good a tool: years it lasts before it breaks, drawn from the range

#![enable(implicit_some)]
[
    (
        name: "food",
        sector: "farming",
        color: (92, 170, 74),
        provides: [("nourishment", 1.0)],
        recipe: (
            rate: 0.08,
            uses: "land",
            improves: 0.015,
            tools: [
                (good: "wooden plough", multiplier: 1.5),
                (good: "iron plough", multiplier: 2.5),
            ],
        ),
    ),
    (
        name: "flax",
        sector: "flax-growing",
        color: (205, 205, 110),
        recipe: (rate: 2.0, uses: "land", improves: 0.01),
    ),
    (
        name: "cloth",
        sector: "spinning & weaving",
        color: (240, 120, 90),
        recipe: (rate: 0.5, inputs: [("flax", 2.0)], improves: 0.02),
    ),
    (
        name: "clothing",
        sector: "tailoring",
        color: (245, 175, 200),
        provides: [("warmth", 1.0)],
        recipe: (rate: 1.0, inputs: [("cloth", 1.0)], improves: 0.005),
    ),
    (
        name: "furniture",
        sector: "carpentry",
        color: (230, 158, 52),
        provides: [("comfort", 1.0)],
        recipe: (rate: 1.0, inputs: [("wood", 0.5)], improves: 0.005),
    ),
    (
        name: "wood",
        sector: "forestry",
        color: (140, 98, 57),
        recipe: (rate: 2.0, uses: "forest", improves: 0.005),
    ),
    (
        name: "charcoal",
        sector: "charcoal-burning",
        color: (96, 96, 104),
        recipe: (rate: 1.0, inputs: [("wood", 3.0)]),
    ),
    (
        name: "ore",
        sector: "mining",
        color: (128, 146, 170),
        recipe: (rate: 0.5, uses: "ore", improves: 0.005),
    ),
    (
        name: "iron",
        sector: "smelting",
        color: (200, 80, 120),
        recipe: (rate: 0.5, inputs: [("ore", 2.0), ("charcoal", 2.0)], improves: 0.01),
    ),
    (
        name: "wooden plough",
        sector: "wooden plough-making",
        color: (214, 190, 140),
        recipe: (rate: 0.25, inputs: [("wood", 2.0)]),
        lifetime: (3.0, 8.0),
