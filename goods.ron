// Every good in the economy and how it is made. What people want is in people.ron.
//
// provides      what one unit gives a person, e.g. [("nourishment", 1.0)]; tools and inputs provide nothing
// recipe:
//   rate        units made per hour of work
//   uses_land   output scales with the worker's land quality
//   improves    rate grows each year when "improving goods get better" is on
//   inputs      goods used up per unit made, e.g. [("wares", 2.0)]
//   tool        a durable good that multiplies this recipe's rate, up to one per person
// depreciation  share of a durable good's stock that wears out each year

#![enable(implicit_some)]
[
    (
        name: "food",
        sector: "farming",
        color: (92, 170, 74),
        provides: [("nourishment", 1.0)],
        recipe: (
            rate: 0.08,
            uses_land: true,
            improves: true,
            tool: (good: "plough", multiplier: 2.0),
        ),
    ),
    (
        name: "wares",
        sector: "crafting",
        color: (230, 158, 52),
        provides: [("comfort", 1.0)],
        recipe: (rate: 1.0),
    ),
    (
        name: "plough",
        sector: "plough-making",
        color: (176, 112, 214),
        recipe: (rate: 0.05, inputs: [("wares", 2.0)]),
        depreciation: 0.05,
    ),
]
