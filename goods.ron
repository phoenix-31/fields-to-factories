// Every good in the economy and how it is made. What people want is in people.ron.
//
// sector        where the work sits in the industry tree, broadest first; the last name is this good's
//               own activity, e.g. ["primary", "agriculture", "wheat farming"]. The chart groups by it
// color         colour of the activity; a group's colour is the average of its goods
// provides      what one unit gives a person, e.g. [("nourishment", 1.0)]; tools and inputs provide nothing
// recipe:
//   rate        units made per hour of work
//   uses        a resource whose quality (per person, see people.ron) scales the rate
//   inputs      goods used up per unit made, e.g. [("wood", 2.0)]
//   tools       tools that multiply this recipe's rate; a person works with the best one they own
// lifetime      makes the good a tool: years it lasts before it breaks, drawn from the range
// bulk          how hard one unit is to carry, relative to wheat (default 1); see travel_cost in map.ron

#![enable(implicit_some)]
[
    (
        name: "wheat",
        sector: ["primary", "agriculture", "wheat farming"],
        color: (92, 170, 74),
        provides: [("nourishment", 1.0)],
        recipe: (
            rate: 0.08,
            uses: "land",
            tools: [
                (good: "wooden plough", multiplier: 1.5),
                (good: "iron plough", multiplier: 2.5),
            ],
        ),
    ),
    (
        name: "wool",
        sector: ["primary", "agriculture", "sheep-herding"],
        bulk: 0.5,
        color: (205, 205, 110),
        recipe: (rate: 2.0, uses: "pasture"),
    ),
    (
        name: "cloth",
        sector: ["secondary", "textiles", "spinning & weaving"],
